<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ data.title }}</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<style>
  :root {
    --bg: {{ theme.get('background', '#ffffff') }};
    --fg: {{ theme.get('font_color', '#111111') }};
    --header-bg: {{ theme.get('header_bg', '#8e24aa') }};
    --header-fg: {{ theme.get('header_font_color', '#ffffff') }};
    --font-family: {{ theme.get('font_family', "'Segoe UI', Arial, sans-serif") }};
    --card-bg: {{ theme.get('card_bg', 'rgba(0,0,0,0.03)') }};
    /* Overall size of text/lines, adjustable live via the zoom control —
       persisted in localStorage so it survives refreshes and the 6h reload. */
    --scale: 1;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0; padding: 0; width: 100%; height: 100%;
    background: var(--bg); color: var(--fg); font-family: var(--font-family);
    overflow: hidden;
  }
  body { display: flex; flex-direction: column; }

  /* Thin accent rule instead of a heavy colour band: keeps the theme colour
     present at a distance without eating vertical space or contrast. */
  .accent { flex: none; height: calc(0.95vh * var(--scale)); background: var(--header-bg); }

  .header {
    flex: none; display: flex; align-items: center; gap: 2vw;
    padding: 2.8vh 3.3vw 2.4vh;
  }
  .header img { height: calc(6vh * var(--scale)); }
  .header h1 {
    margin: 0; font-size: calc(4.8vh * var(--scale)); font-weight: 700; letter-spacing: -0.015em;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .header .right { margin-left: auto; display: flex; align-items: center; gap: 1.5vw; }
  .header .progress { font-size: calc(2.4vh * var(--scale)); font-weight: 600; opacity: 0.6; white-space: nowrap; }
  .header .updated {
    display: flex; align-items: center; gap: 0.7vw;
    background: var(--header-bg); color: var(--header-fg);
    padding: 1.1vh 1.25vw; border-radius: 999px;
    font-size: calc(2.4vh * var(--scale)); font-weight: 600; white-space: nowrap;
  }
  .header .dot {
    width: 1.3vh; height: 1.3vh; border-radius: 50%;
    background: currentColor; opacity: 0.9;
  }

  .stats {
    flex: none; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr;
    gap: 1.35vw; padding: 0 3.3vw 2.8vh;
  }
  .stat {
    background: var(--card-bg); border-radius: 16px;
    padding: 2.4vh 1.6vw 2.6vh;
    border-top: calc(0.75vh * var(--scale)) solid var(--stat-color, var(--header-bg));
    display: flex; flex-direction: column; gap: 0.5vh; min-width: 0;
  }
  .stat .top { display: flex; align-items: center; gap: 0.7vw; }
  .stat .label {
    font-size: calc(2.4vh * var(--scale)); font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; white-space: nowrap;
    overflow: hidden; text-overflow: ellipsis;
  }
  .stat .caption {
    margin-left: auto; font-size: calc(2vh * var(--scale)); font-weight: 600;
    opacity: 0.6; white-space: nowrap;
  }
  .stat .value {
    font-size: calc(7.6vh * var(--scale)); font-weight: 700; line-height: 1.05;
    letter-spacing: -0.02em; font-variant-numeric: tabular-nums;
  }

  .chart-wrap { flex: 1; min-height: 0; padding: 0 3.3vw 4vh; }
  .chart-inner {
    height: 100%; padding-top: 2vh;
    border-top: 1px solid color-mix(in srgb, var(--fg) 14%, transparent);
  }

  #stale-banner {
    flex: none; display: none; text-align: center; font-weight: 700;
    font-size: 2.4vh; padding: 1vh; background: #b71c1c; color: #fff;
    letter-spacing: 0.02em;
  }

  /* Zoom control — deliberately understated (this is a wall display, not an
     app): a translucent pill in the corner that only asserts itself once
     someone's mouse/remote actually finds it. */
  .zoom-ctl {
    position: fixed; right: 1.2vw; bottom: 1.2vh; z-index: 1000;
    display: flex; align-items: center; gap: 0.6vw;
    background: rgba(0,0,0,0.55); color: #fff; border-radius: 999px;
    padding: 0.7vh 0.9vw; font-family: var(--font-family);
    opacity: 0.15; transition: opacity 0.2s ease;
  }
  .zoom-ctl:hover, .zoom-ctl:focus-within { opacity: 0.95; }
  .zoom-ctl button {
    width: 3.2vh; height: 3.2vh; border-radius: 50%; border: none; cursor: pointer;
    background: rgba(255,255,255,0.15); color: #fff; font-size: 1.9vh; font-weight: 700;
    line-height: 1; display: flex; align-items: center; justify-content: center;
  }
  .zoom-ctl button:hover { background: rgba(255,255,255,0.32); }
  .zoom-ctl button:disabled { opacity: 0.35; cursor: default; }
  .zoom-ctl #zoom-level {
    min-width: 4.5ch; text-align: center; font-size: 1.7vh; font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
</style>
</head>
<body>
  <div id="stale-banner">Data feed hasn't refreshed recently — showing the last good data.</div>
  <div class="accent"></div>
  <div class="header">
    {% if data.logo_url %}<img src="{{ data.logo_url }}" alt="logo">{% endif %}
    <h1>{{ data.title }}</h1>
    <div class="right">
      <div class="progress" id="progress"></div>
      <div class="updated"><span class="dot"></span><span id="updated-at"></span></div>
    </div>
  </div>
  <div class="stats" id="stats-row"></div>
  <div class="chart-wrap"><div class="chart-inner"><canvas id="chart"></canvas></div></div>

  <div class="zoom-ctl" id="zoom-ctl">
    <button id="zoom-out" aria-label="Zoom out" type="button">&minus;</button>
    <span id="zoom-level">100%</span>
    <button id="zoom-in" aria-label="Zoom in" type="button">&plus;</button>
  </div>

<script>
const DASHBOARD_NAME = {{ data.name | tojson }};
const REFRESH_MS = {{ data.refresh_seconds }} * 1000;
const CURRENCY_SYMBOL = {{ data.currency_symbol | tojson }};
const UNIT = {{ data.unit | tojson }};
let chart = null;
let lastGoodAt = Date.now();
let todayIdx = -1;
let lastPayload = null;

const cssVar = (n) => getComputedStyle(document.documentElement).getPropertyValue(n).trim();

// --- Zoom control: overall text/line scale, adjustable on the page and
// persisted so it survives data refreshes and the 6h safety-net reload. ---
const SCALE_MIN = 0.55, SCALE_MAX = 1.3, SCALE_STEP = 0.05;
const clampScale = (v) => Math.min(SCALE_MAX, Math.max(SCALE_MIN, Math.round(v * 20) / 20));
let scale = clampScale(parseFloat(localStorage.getItem('dashboardScale')) || 1);

function setScale(next) {
  scale = clampScale(next);
  document.documentElement.style.setProperty('--scale', scale);
  document.getElementById('zoom-level').textContent = Math.round(scale * 100) + '%';
  document.getElementById('zoom-out').disabled = scale <= SCALE_MIN;
  document.getElementById('zoom-in').disabled = scale >= SCALE_MAX;
  localStorage.setItem('dashboardScale', String(scale));
  // Text (CSS vh + var(--scale)) updates immediately via the stylesheet;
  // the chart's own font/line sizes are plain JS numbers, so rebuild it.
  if (chart && lastPayload) { chart.destroy(); chart = null; renderChart(lastPayload); }
}
document.getElementById('zoom-in').addEventListener('click', () => setScale(scale + SCALE_STEP));
document.getElementById('zoom-out').addEventListener('click', () => setScale(scale - SCALE_STEP));
setScale(scale); // sync label/button state before the first paint

function fmtValue(v) {
  if (v === null || v === undefined) return '-';
  const n = Math.round(v).toLocaleString();
  return UNIT === 'currency' ? CURRENCY_SYMBOL + n : n;
}

// Short axis labels — full precision lives in the stat cards, the axis only
// needs to be readable from across the room.
function fmtCompact(v) {
  const prefix = UNIT === 'currency' ? CURRENCY_SYMBOL : '';
  const a = Math.abs(v);
  if (a >= 1e6) return prefix + (v / 1e6).toFixed(1).replace(/\.0$/, '') + 'm';
  if (a >= 1e3) return prefix + Math.round(v / 1e3) + 'k';
  return prefix + Math.round(v);
}

// Resolve any CSS colour (hex, rgb(), named) the theme/series config may use
// into rgba, so the actuals can get a soft fill in their own colour.
const _probe = document.createElement('canvas').getContext('2d');
function withAlpha(color, alpha) {
  _probe.fillStyle = '#000';
  _probe.fillStyle = color;
  const c = _probe.fillStyle;
  if (c[0] === '#') {
    const n = parseInt(c.slice(1), 16);
    return `rgba(${(n >> 16) & 255},${(n >> 8) & 255},${n & 255},${alpha})`;
  }
  return c.replace(/^rgba?\(([^)]+)\)$/, (m, inner) =>
    `rgba(${inner.split(',').slice(0, 3).join(',')},${alpha})`);
}

// Round-number gridlines (…, 100k, 200k, …) so progress can be eyeballed from
// across the room instead of read off the axis. Picks a 1/2/2.5/5 x 10^n step
// that yields roughly `target` bands, then rounds the axis top up to it.
function niceScale(max, target) {
  if (!isFinite(max) || max <= 0) return null;
  const raw = max / target;
  const mag = Math.pow(10, Math.floor(Math.log10(raw)));
  const step = [1, 2, 5, 10].map(m => m * mag).find(v => v >= raw) || 10 * mag;
  return { step, max: Math.ceil(max / step) * step };
}

function seriesMax(payload) {
  let m = 0;
  payload.series.forEach(s => s.data.forEach(v => {
    if (v !== null && v !== undefined && v > m) m = v;
  }));
  return m;
}

// A series with no gaps runs to month end: it's a reference/pace line
// (Target, Breakeven) rather than an actual.
const isReference = (s) => s.data.length > 0 && s.data.every(v => v !== null && v !== undefined);
function lastFilled(s) {
  let i = -1;
  s.data.forEach((v, k) => { if (v !== null && v !== undefined) i = k; });
  return i;
}

function renderStats(payload) {
  const row = document.getElementById('stats-row');
  const refs = payload.series.filter(isReference);
  const baseline = refs.length ? refs[0] : null;
  const baseValue = baseline ? payload.latest[baseline.key] : null;

  row.innerHTML = '';
  payload.series.forEach(s => {
    let caption = '';
    if (isReference(s)) {
      caption = 'month end';
    } else if (baseValue) {
      caption = Math.round((payload.latest[s.key] / baseValue) * 100) + '% of ' +
                baseline.label.toLowerCase();
    }
    const div = document.createElement('div');
    div.className = 'stat';
    div.style.setProperty('--stat-color', s.color);
    div.innerHTML =
      `<div class="top"><div class="label"></div><div class="caption"></div></div>` +
      `<div class="value"></div>`;
    div.querySelector('.label').textContent = s.label;
    div.querySelector('.caption').textContent = caption;
    div.querySelector('.value').textContent = fmtValue(payload.latest[s.key]);
    row.appendChild(div);
  });
}

function renderProgress(payload) {
  const el = document.getElementById('progress');
  const actuals = payload.series.filter(s => !isReference(s));
  const idx = actuals.length ? Math.max(...actuals.map(lastFilled)) : payload.labels.length - 1;
  todayIdx = idx;
  el.textContent = idx >= 0 ? `Day ${idx + 1} of ${payload.labels.length}` : '';
}

// Dashed marker at the last day with actual data, so the empty rest of the
// month reads as "not yet" rather than "fell off a cliff".
const todayLine = {
  id: 'todayLine',
  beforeDatasetsDraw(c) {
    if (todayIdx < 0 || todayIdx >= c.data.labels.length - 1) return;
    const x = c.scales.x.getPixelForValue(todayIdx);
    const ctx = c.ctx;
    ctx.save();
    ctx.strokeStyle = withAlpha(cssVar('--fg') || '#111', 0.28);
    ctx.lineWidth = 2 * scale;
    ctx.setLineDash([6 * scale, 6 * scale]);
    ctx.beginPath();
    ctx.moveTo(x, c.chartArea.top);
    ctx.lineTo(x, c.chartArea.bottom);
    ctx.stroke();
    ctx.restore();
  }
};

function buildDatasets(payload) {
  return payload.series.map(s => {
    const ref = isReference(s);
    return {
      label: s.label,
      data: s.data,
      borderColor: s.color,
      backgroundColor: ref ? 'transparent' : withAlpha(s.color, 0.07),
      fill: ref ? false : 'origin',
      borderWidth: (ref ? 2 : 3) * scale,
      borderDash: ref ? [12 * scale, 10 * scale] : [],
      pointRadius: 0,
      pointHoverRadius: 6 * scale,
      pointHoverBorderWidth: 2 * scale,
      pointHoverBorderColor: cssVar('--bg') || '#fff',
      pointHitRadius: 0,
      tension: 0.2,
      spanGaps: false,
    };
  });
}

// "Tue 14 Jul" for daily labels; anything non-ISO passes through as-is.
function fmtTooltipDate(label) {
  const l = String(label ?? '');
  if (!/^\d{4}-\d{2}-\d{2}$/.test(l)) return l;
  return new Date(l + 'T00:00:00').toLocaleDateString([], {
    weekday: 'short', day: 'numeric', month: 'short',
  });
}

function renderChart(payload) {
  const datasets = buildDatasets(payload);
  const nice = niceScale(seriesMax(payload), 10);

  if (chart) {
    chart.data.labels = payload.labels;
    chart.data.datasets = datasets;
    if (nice) {
      chart.options.scales.y.max = nice.max;
      chart.options.scales.y.ticks.stepSize = nice.step;
    }
    chart.update('none');
    return;
  }

  const fg = cssVar('--fg') || '#111';
  const muted = withAlpha(fg, 0.62);
  const grid = withAlpha(fg, 0.14);
  const axisFontSize = Math.round(22 * scale);

  chart = new Chart(document.getElementById('chart').getContext('2d'), {
    type: payload.chart_type || 'line',
    data: { labels: payload.labels, datasets },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      animation: false,
      layout: { padding: { right: 8 } },
      // The stat cards are the legend; the tooltip is for someone who walks up
      // to the screen and wants the running total on a specific day.
      plugins: {
        legend: { display: false },
        tooltip: {
          enabled: true,
          mode: 'index',
          intersect: false,
          displayColors: true,
          backgroundColor: withAlpha(fg, 0.92),
          titleColor: cssVar('--bg') || '#fff',
          bodyColor: cssVar('--bg') || '#fff',
          titleFont: { size: Math.round(20 * scale), weight: '700' },
          bodyFont: { size: Math.round(20 * scale), weight: '600' },
          padding: Math.round(14 * scale),
          boxPadding: Math.round(6 * scale),
          cornerRadius: 8,
          callbacks: {
            title: (items) => fmtTooltipDate(items[0].label),
            label: (item) => ' ' + item.dataset.label + '  ' + fmtValue(item.parsed.y),
          },
        },
      },
      // Hover anywhere in the column, not just exactly on a line.
      interaction: { mode: 'index', intersect: false },
      hover: { mode: 'index', intersect: false },
      scales: {
        x: {
          border: { color: withAlpha(fg, 0.25) },
          grid: { display: false },
          ticks: {
            color: muted, font: { size: axisFontSize, weight: '600' },
            maxRotation: 0, autoSkipPadding: 24,
            // Day-of-month only: "01" not "2026-07-01".
            callback: (v, i) => {
              const l = String(payload.labels[i] ?? '');
              return /^\d{4}-\d{2}-\d{2}$/.test(l) ? String(Number(l.slice(-2))) : l;
            },
          },
        },
        y: {
          border: { display: false },
          beginAtZero: true,
          max: nice ? nice.max : undefined,
          grid: { color: grid, lineWidth: 1 },
          ticks: {
            color: muted, font: { size: axisFontSize, weight: '600' },
            stepSize: nice ? nice.step : undefined,
            autoSkip: false, padding: 10,
            callback: (v) => fmtCompact(v),
          },
        },
      },
    },
    plugins: [todayLine],
  });
}

function applyPayload(payload) {
  lastPayload = payload;
  renderProgress(payload);
  renderStats(payload);
  renderChart(payload);
  const stamp = new Date(payload.generated_at);
  document.getElementById('updated-at').textContent =
    stamp.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  lastGoodAt = Date.now();
  document.getElementById('stale-banner').style.display = 'none';
}

async function refresh() {
  try {
    const res = await fetch(`./data.json?t=${Date.now()}`, { cache: 'no-store' });
    if (!res.ok) throw new Error(res.status);
    applyPayload(await res.json());
  } catch (e) {
    console.error('dashboard refresh failed', e);
    if (Date.now() - lastGoodAt > REFRESH_MS * 4) {
      document.getElementById('stale-banner').style.display = 'block';
    }
  }
}

// Initial paint uses the data baked in at generation time — no fetch needed
// for first render, so the screen shows something immediately even if the
// network is briefly unavailable. The live data source (a Worker on its own
// cron) now updates far more often than this HTML is redeployed, so the
// baked-in payload can be meaningfully stale — kick off a live refresh right
// away rather than waiting a full interval to find out.
applyPayload({{ data | tojson }});
refresh();
setInterval(refresh, REFRESH_MS);

// Safety-net full reload every 6h to clear any stuck JS state / memory growth
// on a screen nobody is going to babysit.
setTimeout(() => location.reload(), 6 * 60 * 60 * 1000);
</script>
</body>
</html>
